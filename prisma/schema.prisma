generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Area {
  id        String   @id
  name      String
  address   String   @default("Việt Nam quốc, Tiền Giang tỉnh, Gò Công thị xã, Bình Xuân xã")
  code      String   @unique
  families  Family[]
  groups    Group[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Group {
  id          String   @id
  name        String
  description String?
  families    Family[]
  areaId      String?
  area        Area?    @relation(fields: [areaId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Family {
  id               String   @id
  name             String
  representativeId String?  @unique // One-to-one with Member (optional initially)
  groupId          String
  areaId           String
  group            Group    @relation(fields: [groupId], references: [id])
  area             Area     @relation(fields: [areaId], references: [id])
  members          Member[] @relation("FamilyMembers")
  representative   Member?  @relation("FamilyRepresentative", fields: [representativeId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum Gender {
  MALE
  FEMALE
}

model Member {
  id                     String   @id
  fullName               String
  birthYear              Int
  gender                 Gender
  familyId               String
  family                 Family   @relation("FamilyMembers", fields: [familyId], references: [id])
  representedFamily      Family?  @relation("FamilyRepresentative")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
